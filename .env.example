# VamsiCompanion configuration
# Copy to .env and adjust. Paths must be absolute on Windows.

# Bind address. Keep localhost for laptop-only mode.
HOST=127.0.0.1
PORT=8765

# Phone access mode is enabled by scripts\start_phone.ps1.
# It binds to Wi-Fi and requires a pairing token for API calls.
PHONE_ACCESS_ENABLED=0
# Optional fixed token. Leave blank to let the app create data\pairing_token.txt.
# PAIRING_TOKEN=

# Data and model locations (keep on D:)
DATA_DIR=D:\VamsiCompanion\data
MODEL_PATH=D:\VamsiCompanion\models\qwen2.5-1.5b-instruct-q4_k_m.gguf

# Model runtime options
N_CTX=2048
N_THREADS=8
MAX_TOKENS=512
TEMPERATURE=0.7

# Conversation window (bounded context)
MAX_TURNS=12

# Tool loop safety
MAX_TOOL_ITERATIONS=4
REQUEST_TIMEOUT_SECONDS=180
